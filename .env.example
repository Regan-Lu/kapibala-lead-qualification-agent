# Google AI Studio authorization key; never commit a filled .env.
GEMINI_API_KEY=
# Override only with a currently supported Gemini model ID.
GEMINI_MODEL=gemini-3.7-flash

# File-backed SQLite database used for session state and event history.
LEAD_AGENT_DB_PATH=lead_qualification_agent.db

# Local demo operator routes require this request-header token.
OPERATOR_TOKEN=
